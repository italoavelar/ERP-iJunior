generator client {
  provider      = "prisma-client-js"
  /// rhel-openssl-3.0.x é o ambiente das funções da Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Product {
  LOOP
  START
}

/// Membro do time que pode ser responsável por atividades.
model Person {
  id       String @id @default(cuid())
  name     String
  initials String

  activities Activity[] @relation("ActivityAssignees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("people")
}

/// Atividade do time financeiro.
model Activity {
  id      String  @id @default(cuid())
  title   String
  details String  @default("")
  done    Boolean @default(false)
  /// Preenchido quando `done` vira true; zerado ao reabrir.
  doneAt  DateTime? @db.Date

  assignees Person[] @relation("ActivityAssignees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([done])
  @@map("activities")
}

/// Projeto contratado, com o acompanhamento financeiro.
model Project {
  id          String   @id @default(cuid())
  name        String
  /// Quem contrata e paga.
  client      String   @default("")
  description String   @default("")
  /// Observação financeira principal (ex.: "Contrato sem assinatura").
  notes       String   @default("")
  /// null enquanto o produto não foi definido.
  product     Product?
  /// P.O. (gerente) responsável pelo projeto.
  po          String   @default("")
  running     Boolean  @default(true)

  sprints Sprint[]

  /// Total contratado e valor pago são derivados das parcelas — ver
  /// modules/projects/service.ts. Guardá-los aqui criaria um espelho que
  /// diverge do plano na primeira edição.
  installments Installment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([running])
  @@map("projects")
}

/// Parcela do plano de pagamento. O "próximo pagamento" que as telas mostram
/// sai daqui: é a primeira parcela ainda não paga.
model Installment {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Posição no plano, começando em 1.
  number      Int
  /// Ex.: "Entrada", "Após Sprint 4", "Módulo 2 – à vista".
  description String   @default("")
  /// null = condicionada a um marco (NF, sprint, entrega) que ainda não ocorreu.
  dueDate     DateTime? @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  paid        Boolean  @default(false)
  paidAt      DateTime? @db.Date
  /// Valor efetivamente recebido, quando difere do previsto.
  paidAmount  Decimal? @db.Decimal(12, 2)
  /// Sprint cuja validação libera a cobrança desta parcela.
  sprintNumber Int?
  notes       String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@index([projectId, paid])
  @@map("installments")
}

/// Sprint de um projeto pago por marco de sprint. Validar a sprint libera a
/// cobrança das parcelas ligadas a ela.
model Sprint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number      Int
  validated   Boolean   @default(false)
  /// Pode ficar vazio numa sprint validada cuja data não foi registrada.
  validatedAt DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@map("sprints")
}
