{
  "name": "ijunior-erp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10.0.0 <11"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@ijunior/api",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.json && npm run typecheck --workspace=@ijunior/api",
    "test": "npm run test:unit && npm run test:integration && npm run test:api && npm run test:web",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
