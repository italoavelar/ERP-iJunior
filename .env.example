# Local development database connections. Keep all real values in untracked .env files.
# DATABASE_URL is used by the application; DIRECT_URL is used only by Prisma CLI.
DATABASE_URL=
DIRECT_URL=
DATABASE_URL_TEST=
PORT=8787
NODE_ENV=development
VITE_API_PROXY_TARGET=http://localhost:8787
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for production/homologation API: prisma (the persisted Contract Registry adapter).
CONTRACT_REFERENCE_ADAPTER=prisma

# Development seed values. Keep these in an ignored local .env file.
DEV_MANAGER_EMAIL=
DEV_MANAGER_PASSWORD=
DEV_VP_EMAIL=
DEV_VP_PASSWORD=
DEV_NO_FINANCE_EMAIL=
DEV_NO_FINANCE_PASSWORD=
DEV_PLATFORM_ADMIN_EMAIL=
DEV_PLATFORM_ADMIN_PASSWORD=
DEV_CONTRACT_ID=dev-contract-001
DEV_CLIENT_ID=dev-client-001
DEV_CONTRACT_CENTS=100000

# Explicit, one-time homologation bootstrap. This script creates only a new
# sanitized user and never runs during a deployment or overwrites an existing user.
STAGING_MANAGER_EMAIL=
STAGING_MANAGER_PASSWORD=
STAGING_MANAGER_NAME=Usuário de Homologação

# Vercel Web runtime only. Use the API project's HTTPS deployment origin, without a trailing slash.
BACKEND_URL=
